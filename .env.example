# ==============================================================================
# StudentAI — Environment Variables (Template / Placeholders Only)
# ==============================================================================
# DO NOT place real credentials or keys in this file or commit them to Git.
# Copy this file to .env.local for local development.
# On Vercel, configure these under Project Settings -> Environment Variables.
# All keys remain strictly SERVER-SIDE. NEVER prefix with NEXT_PUBLIC_.

# --- Database & Persistence (Neon PostgreSQL) ---
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/studentai?sslmode=require

# --- Server-Side Session & Cryptographic Authentication ---
AUTH_SECRET=your_long_random_cryptographic_secret_here

# --- Admin Credentials ---
ADMIN_EMAIL=logindetails-admin@gmail.com
ADMIN_PASSWORD=your_secure_admin_password_here
# Optional SHA-256 hash alternative:
# ADMIN_PASSWORD_HASH=

# --- AI Provider API Keys (Server-Side Only) ---
GOOGLE_AI_API_KEY=your_google_ai_studio_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- AI Routing Hierarchy (Fallback: Primary -> Secondary -> Tertiary) ---
AI_PRIMARY_PROVIDER=google
AI_SECONDARY_PROVIDER=groq
AI_TERTIARY_PROVIDER=openrouter

# --- AI Models ---
AI_GOOGLE_MODEL=gemini-2.5-flash
AI_GROQ_MODEL=openai/gpt-oss-120b
AI_OPENROUTER_MODEL=openrouter/free

# --- Platform & Analytics Tuning ---
ANALYTICS_ACTIVE_WINDOW_MINUTES=5
ANALYTICS_RETENTION_DAYS=30
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_HOUR=60
