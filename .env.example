# ==============================================================================
# StudentAI — Server-Side AI Environment Variables (Template)
# ==============================================================================
# DO NOT add real keys to this file. Copy this file to .env.local for local development.
# On Vercel, configure these variables in Project Settings -> Environment Variables.
# NEVER prefix these with NEXT_PUBLIC_. They must remain strictly server-side.

# Provider API Keys
GOOGLE_AI_API_KEY=your_google_ai_studio_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Provider Hierarchy (Fallback order: Primary -> Secondary -> Tertiary)
AI_PRIMARY_PROVIDER=google
AI_SECONDARY_PROVIDER=groq
AI_TERTIARY_PROVIDER=openrouter

# Model Identifiers (Configurable per environment)
AI_GOOGLE_MODEL=gemini-2.5-flash
AI_GROQ_MODEL=openai/gpt-oss-120b
AI_OPENROUTER_MODEL=openrouter/free

# Rate Limiting & Safety (Optional defaults)
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_HOUR=60
